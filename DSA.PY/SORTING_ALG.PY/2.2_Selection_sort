# NESTED 

#   0     1     2    3    4  5   6
s=[1000, 250, 15000, 50, 33, 2, 0.5]


for i in range(len(s)): 
    minp=i
    for j in range(1+i, len(s)):
        if s[j] < s[minp]:
            minp=j
    s[i], s[minp] = s[minp], s[i]

