        minp=i                 

x[3], x[minp] = x[minp], x[3]  

print("FORTH PASS DATA--->", x)        #-------> FORTH PASS DATA---> [2, 9, 18, 20, 40, 100, 35]

print()

minp=4

for i in range(5,len(x)):
