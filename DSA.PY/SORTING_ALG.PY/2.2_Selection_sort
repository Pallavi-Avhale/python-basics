'''
SELECTION_SORT

IT WORK ON MINIMUM OR LIMITED DATA
TO REDUCE COMPARISION
HERE WE NEED TO CONSIDER 1 ASSUMED POSITION (ALWAYS 0TH POSITION) 
                  ||
 THROUGH THESE ASSUMED POSITION OTHER ELEMENTS GETTING SORT 

 x=[3,7,10,1,2]

internally

   0 1  2 3  4
x=[3,7,10,1, 2]

ASS POS (MIN POS) = 0TH POSITION 

0TH ----> X[0]= 3
        X[0]>X[1]   ----------> 3 > 7   -l----> FALSE
        X[0]>X[2]   ----------> 3 > 10  -----> FALSE
        X[0]>X[3]   ----------> 3 > 1   -----> TRUE ----------> HERE WE NEED TO CHANGE THE ASSUMED POSITION VALUE
        NOW ASSUMED POS =3
        X[3]>X[4]   ----------> 1 > 2  -----> FALSE 
        SWAP
        X[0],X[3]=X[3],X[0]

        3   7   10   1   2

        1   7   10   3   2 ----------> UPDATED --------> X[0] --> SORT --> MOVING TO NEXT CELL OR ASSUMED POSITION 
INDEX   0   1   2    3   4
NEXT 
 
----------> X[1]= ASSUMED POS
            X[1]>X[2] -----------> 7 > 10 -------> FALSE
            X[1]>X[3] -----------> 7 > 3  -------> TRUE 

----------->X[3]=ASSUMED POS
            X[3]>X[4] -----------> 3 > 2  -------> TRUE

-----------> ASSUMED POS (MIN P) = 4
            X[1] , X[4] = X[4], X[1]     ---------> SWAP THE POSITION

UPDATED LIST ---> 1   2   10   3   7




        
Y=[100, 2, 20, 35, 40, 9 , 18]     
'''

x=[100, 2, 20, 35, 40, 9, 18] 
minp=0

print(x[minp])       #---> 100 ----> x[0] ---> assumed pos


# ----------------------------------------------------
print()

x=[100, 2, 20, 35, 40, 9, 18] 
minp=0

for i in range(1,len(x)):
    if x[minp]>x[i]:           #--> TRUE--> x[i]-----> position start from index 1  x[1] / x[i] --> 2 & x[minp]=0 ---> 100> 20 --> TRUE --> UPDATE MINP IS 1
        minp=i                 #---> minp=i ---------> 1 = 1

x[0], x[minp] = x[minp], x[0]  #----> x[0]--> 100 & x[minp]--> 2 ----> swap

print("FIRST PASS DATA--->", x)                       #---->[2, 100, 20, 35, 40, 9, 18]

print()

# SECOND SWAP

minp=1

for i in range(2,len(x)):
    if x[minp]>x[i]:          
        minp=i                

x[1], x[minp] = x[minp], x[1]  

